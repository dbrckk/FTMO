//@version=6
strategy("XAUUSD Inter-Style ICT Dynamic v3", overlay=true, pyramiding=0,
     process_orders_on_close=false, calc_on_order_fills=true,
     initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=0.25,
     max_labels_count=500, max_boxes_count=250, max_lines_count=500)

// =====================================================
// XAUUSD ICT/SMC discretionary-style engine
// Top-down: H4/H1 bias -> H2/M30 context -> M15/M5 timing.
// Setup families: continuation, A+ continuation, strict reversal.
// No fixed RR / no fixed TP.
// Management: liquidity-event runner, BE protection, progressive ATR trail,
// structure/momentum invalidation, emergency stop.
// =====================================================

// ---------- Inputs ----------
gSess = "Sessions"
londonSession = input.session("0800-1700", "London", group=gSess)
nySession = input.session("0800-1700", "New York", group=gSess)
londonKZ = input.session("0700-1000", "London Kill Zone", group=gSess)
nyKZ = input.session("0830-1100", "NY Kill Zone", group=gSess)
londonTZ = input.string("Europe/London", "London timezone", group=gSess)
nyTZ = input.string("America/New_York", "New York timezone", group=gSess)
showSessionBg = input.bool(true, "Session background", group=gSess)

gICT = "ICT / SMC"
pivotLen = input.int(3, "Confirmed swing length", minval=1, maxval=10, group=gICT)
minQuality = input.float(2.75, "Base ICT quality", minval=0, step=0.25, group=gICT)
enableContinuation = input.bool(true, "Continuation setups", group=gICT)
enableAPlus = input.bool(true, "A+ continuation labels", group=gICT)
enableReversal = input.bool(true, "Strict reversal setups", group=gICT)
showStructure = input.bool(true, "BOS / CHoCH", group=gICT)
showFVG = input.bool(true, "FVG", group=gICT)
showOTE = input.bool(true, "OTE", group=gICT)
showOB = input.bool(true, "Order Blocks", group=gICT)
showLiquidity = input.bool(true, "Liquidity map", group=gICT)

gScore = "Quality Score"
minScoreTrade = input.int(55, "Minimum score to trade", minval=0, maxval=100, group=gScore)
aPlusScore = input.int(85, "A+ score", minval=50, maxval=100, group=gScore)
eliteScore = input.int(90, "Elite score", minval=50, maxval=100, group=gScore)
sTierScore = input.int(96, "S-Tier score", minval=50, maxval=100, group=gScore)
showScoreLabels = input.bool(true, "Score labels", group=gScore)

gMgmt = "Dynamic Management"
emergencyStop = input.float(8.0, "Continuation emergency stop", minval=1, group=gMgmt)
protectTrigger = input.float(5.0, "Continuation protect after MFE", minval=1, group=gMgmt)
trailATR = input.float(0.25, "Initial protected ATR trail", minval=.1, step=.05, group=gMgmt)
liqTargetMinDist = input.float(3.0, "Liquidity target minimum distance", minval=.5, step=.5, group=gMgmt)
liqTrailATR = input.float(0.15, "ATR trail after liquidity taken", minval=.05, step=.05, group=gMgmt)
reversalEmergency = input.float(6.0, "Reversal emergency stop", minval=1, group=gMgmt)
reversalProtect = input.float(6.0, "Reversal protect after MFE", minval=1, group=gMgmt)
reversalTrailATR = input.float(0.40, "Reversal ATR trail", minval=.1, step=.05, group=gMgmt)
trailTier1 = input.float(10.0, "Trail tier 1 MFE", minval=1, group=gMgmt)
trailTier2 = input.float(15.0, "Trail tier 2 MFE", minval=1, group=gMgmt)
trailATR2 = input.float(0.35, "ATR trail after tier 1", minval=.1, step=.05, group=gMgmt)
trailATR3 = input.float(0.50, "ATR trail after tier 2", minval=.1, step=.05, group=gMgmt)
maxHoldBars = input.int(48, "Maximum hold bars on M5", minval=1, group=gMgmt)
minRearmBars = input.int(12, "Minimum M5-equivalent setup gap", minval=0, group=gMgmt)

gBC = "BC+ Breakout Continuation"
enableBCPlus = input.bool(true, "Enable BC+ engine", group=gBC)
bcOnlyM5 = input.bool(true, "BC+ signals only on M5", group=gBC)
bcAllowLondonOnly = input.bool(false, "Allow London-only BC+ (OOS weak)", group=gBC)
bcAllowNYOnly = input.bool(true, "Allow NY-only BC+", group=gBC)
bcAllowOverlap = input.bool(true, "Allow London/NY overlap BC+", group=gBC)
bcNYSLFloor = input.float(10.0, "NY-only SL floor", minval=1, step=.5, group=gBC)
bcNYSLATR = input.float(6.0, "NY-only SL ATR multiplier", minval=.5, step=.5, group=gBC)
bcNYSLCap = input.float(30.0, "NY-only SL cap", minval=1, step=.5, group=gBC)
bcNYTPFloor = input.float(35.0, "NY-only TP floor", minval=1, step=.5, group=gBC)
bcNYTPATR = input.float(5.0, "NY-only TP ATR multiplier", minval=.5, step=.5, group=gBC)
bcNYMaxHoldBars = input.int(96, "NY-only max hold bars", minval=1, group=gBC)

bcOverlapSLFloor = input.float(18.0, "Overlap SL floor", minval=1, step=.5, group=gBC)
bcOverlapSLATR = input.float(8.0, "Overlap SL ATR multiplier", minval=.5, step=.5, group=gBC)
bcOverlapSLCap = input.float(25.0, "Overlap SL cap", minval=1, step=.5, group=gBC)
bcOverlapTPFloor = input.float(30.0, "Overlap TP floor", minval=1, step=.5, group=gBC)
bcOverlapTPATR = input.float(12.0, "Overlap TP ATR multiplier", minval=.5, step=.5, group=gBC)
bcOverlapMaxHoldBars = input.int(48, "Overlap max hold bars", minval=1, group=gBC)
bcOverlapUseTimeFilter = input.bool(true, "Use validated overlap time filter", group=gBC)
bcOverlapAllowShort11 = input.bool(true, "Allow overlap SHORT 11:00-11:30 NY", group=gBC)

showBCLevels = input.bool(true, "Plot active BC+ TP/SL", group=gBC)

gOsc = "Gold Filters"
stLen = input.int(14, "Stochastic length", minval=5, group=gOsc)
bbLen = input.int(20, "Bollinger EMA length", minval=5, group=gOsc)
bbMult = input.float(2.20, "Bollinger deviation", minval=.5, step=.05, group=gOsc)
bbVolBoost = input.float(.35, "Bollinger volatility boost", minval=0, step=.05, group=gOsc)

// ---------- Sessions ----------
inLondon = not na(time(timeframe.period, londonSession, londonTZ))
inNY = not na(time(timeframe.period, nySession, nyTZ))
inLondonKZ = not na(time(timeframe.period, londonKZ, londonTZ))
inNYKZ = not na(time(timeframe.period, nyKZ, nyTZ))
inKillZone = inLondonKZ or inNYKZ
nyMinutes = hour(time, nyTZ) * 60 + minute(time, nyTZ)
lonMinutes = hour(time, londonTZ) * 60 + minute(time, londonTZ)
robustWindow = (inLondon and inNY) or (nyMinutes >= 600 and nyMinutes < 780)

bgcolor(showSessionBg and inLondon ? color.new(color.blue, 94) : na)
bgcolor(showSessionBg and inNY ? color.new(color.orange, 94) : na)

// ---------- Gold Bollinger + Stochastic ----------
atr14 = ta.atr(14)
bbBasis = ta.ema(close, bbLen)
bbDev = ta.stdev(close, bbLen)
atrMean = ta.sma(atr14, 50)
volRatio = atr14 / math.max(atrMean, syminfo.mintick)
adaptiveMult = bbMult + math.max(0.0, volRatio - 1.0) * bbVolBoost
bbUpper = bbBasis + bbDev * adaptiveMult
bbLower = bbBasis - bbDev * adaptiveMult

ll = ta.lowest(low, stLen)
hh = ta.highest(high, stLen)
rawK = 100 * (close - ll) / math.max(hh - ll, syminfo.mintick)
stK = ta.ema(rawK, 3)
stD = ta.ema(stK, 3)

plot(bbUpper, "Gold BB Upper", color=color.new(color.red, 35))
plot(bbBasis, "Gold BB Basis", color=color.new(color.gray, 55))
plot(bbLower, "Gold BB Lower", color=color.new(color.green, 35))

// ---------- Confirmed structure ----------
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float lastSwingHigh = na
var float lastSwingLow = na
var float prevSwingHigh = na
var float prevSwingLow = na
var int structure = 0

if not na(ph)
    prevSwingHigh := lastSwingHigh
    lastSwingHigh := ph
if not na(pl)
    prevSwingLow := lastSwingLow
    lastSwingLow := pl

bullBreak = not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
bearBreak = not na(lastSwingLow) and close < lastSwingLow and close[1] >= lastSwingLow
bullCHOCH = bullBreak and structure == -1
bearCHOCH = bearBreak and structure == 1
bullBOS = bullBreak and structure != -1
bearBOS = bearBreak and structure != 1

if bullBreak
    structure := 1
if bearBreak
    structure := -1

if showStructure and bullBOS
    label.new(bar_index, low, "BOS ↑", style=label.style_label_up, color=color.new(color.green,20), textcolor=color.white, size=size.tiny)
if showStructure and bearBOS
    label.new(bar_index, high, "BOS ↓", style=label.style_label_down, color=color.new(color.red,20), textcolor=color.white, size=size.tiny)
if showStructure and bullCHOCH
    label.new(bar_index, low, "CHoCH ↑", style=label.style_label_up, color=color.teal, textcolor=color.white, size=size.tiny)
if showStructure and bearCHOCH
    label.new(bar_index, high, "CHoCH ↓", style=label.style_label_down, color=color.maroon, textcolor=color.white, size=size.tiny)

// ---------- OTE ----------
swingRange = not na(lastSwingHigh) and not na(lastSwingLow) ? lastSwingHigh - lastSwingLow : na
bullOTE62 = structure == 1 ? lastSwingHigh - swingRange * .62 : na
bullOTE79 = structure == 1 ? lastSwingHigh - swingRange * .79 : na
bearOTE62 = structure == -1 ? lastSwingLow + swingRange * .62 : na
bearOTE79 = structure == -1 ? lastSwingLow + swingRange * .79 : na
inBullOTE = structure == 1 and not na(bullOTE62) and low <= bullOTE62 and high >= bullOTE79
inBearOTE = structure == -1 and not na(bearOTE62) and high >= bearOTE62 and low <= bearOTE79

pB62 = plot(showOTE ? bullOTE62 : na, "Bull OTE 62", color=color.new(color.green,40), style=plot.style_linebr)
pB79 = plot(showOTE ? bullOTE79 : na, "Bull OTE 79", color=color.new(color.green,40), style=plot.style_linebr)
fill(pB62,pB79,color=color.new(color.green,91))
pS62 = plot(showOTE ? bearOTE62 : na, "Bear OTE 62", color=color.new(color.red,40), style=plot.style_linebr)
pS79 = plot(showOTE ? bearOTE79 : na, "Bear OTE 79", color=color.new(color.red,40), style=plot.style_linebr)
fill(pS62,pS79,color=color.new(color.red,91))

// ---------- FVG ----------
bullFVG = low > high[2]
bearFVG = high < low[2]
bullFVGRecent = ta.barssince(bullFVG) >= 0 and ta.barssince(bullFVG) <= 12
bearFVGRecent = ta.barssince(bearFVG) >= 0 and ta.barssince(bearFVG) <= 12
if showFVG and bullFVG
    box.new(bar_index-2, low, bar_index+16, high[2], bgcolor=color.new(color.green,92), border_color=color.new(color.green,65))
if showFVG and bearFVG
    box.new(bar_index-2, low[2], bar_index+16, high, bgcolor=color.new(color.red,92), border_color=color.new(color.red,65))

// ---------- Order Blocks ----------
var float bullOBHigh = na
var float bullOBLow = na
var float bearOBHigh = na
var float bearOBLow = na

if bullBreak
    int fb = na
    for j = 1 to 12
        if close[j] < open[j] and na(fb)
            fb := j
    if not na(fb)
        bullOBHigh := high[fb]
        bullOBLow := low[fb]
        if showOB
            box.new(bar_index-fb,bullOBHigh,bar_index+30,bullOBLow,bgcolor=color.new(color.green,91),border_color=color.new(color.green,65))

if bearBreak
    int fs = na
    for j = 1 to 12
        if close[j] > open[j] and na(fs)
            fs := j
    if not na(fs)
        bearOBHigh := high[fs]
        bearOBLow := low[fs]
        if showOB
            box.new(bar_index-fs,bearOBHigh,bar_index+30,bearOBLow,bgcolor=color.new(color.red,91),border_color=color.new(color.red,65))

bullOBTouch = not na(bullOBHigh) and low <= bullOBHigh and high >= bullOBLow
bearOBTouch = not na(bearOBHigh) and high >= bearOBLow and low <= bearOBHigh

// ---------- Temporal / major liquidity ----------
pdHigh = request.security(syminfo.tickerid,"D",high[1],lookahead=barmerge.lookahead_off)
pdLow = request.security(syminfo.tickerid,"D",low[1],lookahead=barmerge.lookahead_off)
pwHigh = request.security(syminfo.tickerid,"W",high[1],lookahead=barmerge.lookahead_off)
pwLow = request.security(syminfo.tickerid,"W",low[1],lookahead=barmerge.lookahead_off)
d30High = request.security(syminfo.tickerid,"D",ta.highest(high[1],30),lookahead=barmerge.lookahead_off)
d30Low = request.security(syminfo.tickerid,"D",ta.lowest(low[1],30),lookahead=barmerge.lookahead_off)

var float asiaHigh = na
var float asiaLow = na
var float prevAsiaHigh = na
var float prevAsiaLow = na
var float londonOpen = na
var float nyOpen = na

newLonDay = not na(lonMinutes[1]) and lonMinutes < lonMinutes[1] - 600
if newLonDay
    if not na(asiaHigh)
        prevAsiaHigh := asiaHigh
        prevAsiaLow := asiaLow
    asiaHigh := na
    asiaLow := na
    londonOpen := na
    nyOpen := na

inAsia = lonMinutes >= 0 and lonMinutes < 480
if inAsia
    asiaHigh := na(asiaHigh) ? high : math.max(asiaHigh,high)
    asiaLow := na(asiaLow) ? low : math.min(asiaLow,low)
if lonMinutes >= 480 and na(londonOpen)
    londonOpen := open
if nyMinutes >= 480 and na(nyOpen)
    nyOpen := open

sweepBelow(float level) => not na(level) and low < level and close > level
sweepAbove(float level) => not na(level) and high > level and close < level

bullSwingSweep = sweepBelow(lastSwingLow)
bearSwingSweep = sweepAbove(lastSwingHigh)

bullLiquidityNow =
     (bullSwingSweep ? 1.0 : 0.0) +
     (sweepBelow(prevAsiaLow) ? 1.75 : 0.0) +
     (sweepBelow(londonOpen) ? 1.25 : 0.0) +
     (sweepBelow(nyOpen) ? 1.25 : 0.0) +
     (sweepBelow(pdLow) ? 2.0 : 0.0) +
     (sweepBelow(pwLow) ? 2.25 : 0.0) +
     (sweepBelow(d30Low) ? 2.5 : 0.0)

bearLiquidityNow =
     (bearSwingSweep ? 1.0 : 0.0) +
     (sweepAbove(prevAsiaHigh) ? 1.75 : 0.0) +
     (sweepAbove(londonOpen) ? 1.25 : 0.0) +
     (sweepAbove(nyOpen) ? 1.25 : 0.0) +
     (sweepAbove(pdHigh) ? 2.0 : 0.0) +
     (sweepAbove(pwHigh) ? 2.25 : 0.0) +
     (sweepAbove(d30High) ? 2.5 : 0.0)

bullLiquidityNow += bullLiquidityNow > 0 and inKillZone ? .75 : 0
bearLiquidityNow += bearLiquidityNow > 0 and inKillZone ? .75 : 0
bullLiquidityRecent = ta.highest(bullLiquidityNow,12)
bearLiquidityRecent = ta.highest(bearLiquidityNow,12)

plot(showLiquidity ? pdHigh : na,"PDH",color=color.new(color.fuchsia,55),style=plot.style_stepline)
plot(showLiquidity ? pdLow : na,"PDL",color=color.new(color.fuchsia,55),style=plot.style_stepline)
plot(showLiquidity ? pwHigh : na,"PWH",color=color.new(color.purple,55),style=plot.style_stepline)
plot(showLiquidity ? pwLow : na,"PWL",color=color.new(color.purple,55),style=plot.style_stepline)
plot(showLiquidity ? d30High : na,"30D High",color=color.new(color.red,65),style=plot.style_stepline)
plot(showLiquidity ? d30Low : na,"30D Low",color=color.new(color.green,65),style=plot.style_stepline)
plot(showLiquidity ? prevAsiaHigh : na,"Prev Asia High",color=color.new(color.yellow,55),style=plot.style_stepline)
plot(showLiquidity ? prevAsiaLow : na,"Prev Asia Low",color=color.new(color.yellow,55),style=plot.style_stepline)

// ---------- MTF state ----------
f_tf_state() =>
    _basis=ta.ema(close,20)
    _dev=ta.stdev(close,20)
    _atr=ta.atr(14)
    _am=ta.sma(_atr,50)
    _vr=_atr/math.max(_am,syminfo.mintick)
    _mul=2.20+math.max(0.0,_vr-1.0)*.35
    _up=_basis+_dev*_mul
    _lo=_basis-_dev*_mul
    _ll=ta.lowest(low,14)
    _hh=ta.highest(high,14)
    _rk=100*(close-_ll)/math.max(_hh-_ll,syminfo.mintick)
    _k=ta.ema(_rk,3)
    _d=ta.ema(_k,3)
    _e8=ta.ema(close,8)
    _e20=ta.ema(close,20)
    _e50=ta.ema(close,50)
    _bull=(_e8>_e20 and _e20>_e50?2:0)+(close>_basis or (low<_lo and close>_lo)?1:0)+(_k>_d and _k>=45?1:0)
    _bear=(_e8<_e20 and _e20<_e50?2:0)+(close<_basis or (high>_up and close<_up)?1:0)+(_k<_d and _k<=55?1:0)
    _bull>_bear?1:_bear>_bull?-1:0

tf5=request.security(syminfo.tickerid,"5",f_tf_state(),lookahead=barmerge.lookahead_off)
tf15=request.security(syminfo.tickerid,"15",f_tf_state(),lookahead=barmerge.lookahead_off)
tf30=request.security(syminfo.tickerid,"30",f_tf_state(),lookahead=barmerge.lookahead_off)
tf60=request.security(syminfo.tickerid,"60",f_tf_state(),lookahead=barmerge.lookahead_off)
tf120=request.security(syminfo.tickerid,"120",f_tf_state(),lookahead=barmerge.lookahead_off)
tf240=request.security(syminfo.tickerid,"240",f_tf_state(),lookahead=barmerge.lookahead_off)

biasBull=tf240==1 and tf60!=-1
biasBear=tf240==-1 and tf60!=1
confirmBull=tf120==1 and tf30==1
confirmBear=tf120==-1 and tf30==-1
triggerBull=tf15==1 or tf5==1
triggerBear=tf15==-1 or tf5==-1
fullBull=tf240==1 and tf120==1 and tf60==1 and tf30==1 and tf15==1 and tf5==1
fullBear=tf240==-1 and tf120==-1 and tf60==-1 and tf30==-1 and tf15==-1 and tf5==-1

bullMTFCount=(tf5==1?1:0)+(tf15==1?1:0)+(tf30==1?1:0)+(tf60==1?1:0)+(tf120==1?1:0)+(tf240==1?1:0)
bearMTFCount=(tf5==-1?1:0)+(tf15==-1?1:0)+(tf30==-1?1:0)+(tf60==-1?1:0)+(tf120==-1?1:0)+(tf240==-1?1:0)

// ---------- Displacement ----------
bullDisp=close-open>atr14*.8 and high-low>atr14*1.2
bearDisp=open-close>atr14*.8 and high-low>atr14*1.2
bullDispRecent=ta.barssince(bullDisp)>=0 and ta.barssince(bullDisp)<=6
bearDispRecent=ta.barssince(bearDisp)>=0 and ta.barssince(bearDisp)<=6
bullStructRecent=ta.barssince(bullBOS or bullCHOCH)>=0 and ta.barssince(bullBOS or bullCHOCH)<=6
bearStructRecent=ta.barssince(bearBOS or bearCHOCH)>=0 and ta.barssince(bearBOS or bearCHOCH)<=6

// ---------- Setup families ----------
bullQuality=(bullFVGRecent?2.0:0)+(bullOBTouch?2.0:0)+(inBullOTE?1.25:0)+bullLiquidityRecent+(bullCHOCH?1.5:bullBOS?.75:0)+(tf240==1?.75:0)+(stK>stD?.5:0)
bearQuality=(bearFVGRecent?2.0:0)+(bearOBTouch?2.0:0)+(inBearOTE?1.25:0)+bearLiquidityRecent+(bearCHOCH?1.5:bearBOS?.75:0)+(tf240==-1?.75:0)+(stK<stD?.5:0)

continuationLong=enableContinuation and robustWindow and biasBull and confirmBull and triggerBull and bullQuality>=minQuality
continuationShort=enableContinuation and robustWindow and biasBear and confirmBear and triggerBear and bearQuality>=minQuality

aPlusBullCount=(bullDispRecent?1:0)+(bullFVGRecent?1:0)+(bullOBTouch?1:0)+(inBullOTE?1:0)+(bullLiquidityRecent>=1.5?1:0)+(bullStructRecent?1:0)+(inKillZone?1:0)+(stK>stD?1:0)+(close>bbBasis?1:0)
aPlusBearCount=(bearDispRecent?1:0)+(bearFVGRecent?1:0)+(bearOBTouch?1:0)+(inBearOTE?1:0)+(bearLiquidityRecent>=1.5?1:0)+(bearStructRecent?1:0)+(inKillZone?1:0)+(stK<stD?1:0)+(close<bbBasis?1:0)
continuationAPlusBull=enableAPlus and fullBull and bullDispRecent and aPlusBullCount>=5 and (bullOBTouch or inBullOTE or bullLiquidityRecent>=1.5)
continuationAPlusBear=enableAPlus and fullBear and bearDispRecent and aPlusBearCount>=5 and (bearOBTouch or inBearOTE or bearLiquidityRecent>=1.5)

majorBullSweep=(sweepBelow(pdLow) or sweepBelow(d30Low))
majorBearSweep=(sweepAbove(pdHigh) or sweepAbove(d30High))
majorBullRecent=ta.barssince(majorBullSweep)>=0 and ta.barssince(majorBullSweep)<=8
majorBearRecent=ta.barssince(majorBearSweep)>=0 and ta.barssince(majorBearSweep)<=8
bullCHOCHRecent=ta.barssince(bullCHOCH)>=0 and ta.barssince(bullCHOCH)<=6
bearCHOCHRecent=ta.barssince(bearCHOCH)>=0 and ta.barssince(bearCHOCH)<=6
strictRevLong=enableReversal and robustWindow and inKillZone and majorBullRecent and bullDispRecent and bullCHOCHRecent and (bullFVGRecent or bullOBTouch or inBullOTE) and triggerBull and stK>stD and close>bbBasis and tf240!=-1
strictRevShort=enableReversal and robustWindow and inKillZone and majorBearRecent and bearDispRecent and bearCHOCHRecent and (bearFVGRecent or bearOBTouch or inBearOTE) and triggerBear and stK<stD and close<bbBasis and tf240!=1

// ---------- Empirically calibrated quality score ----------
// Calibration frozen on pre-2020 trades only.
// Annual walk-forward 2020-2025 confirmed monotonic tiers:
// <55 PF 1.013 | 55-69 PF 1.777 | 70-84 PF 1.940 | 85+ PF 3.574.
// Contributions are shrunk empirical log-odds; correlated features are capped.

// Discretizers match the offline calibration exactly.
f_mtf_w(int x) =>
    x <= 2 ? -0.30000000 : x == 3 ? -0.04498879 : 0.24592681

f_ict_w(float x) =>
    int cat = x < 4.5 ? 0 : x < 9.5 ? 1 : x < 14.5 ? 2 : x < 19.5 ? 3 : 4
    cat == 0 ? -0.30000000 : cat == 1 ? -0.07757168 : cat == 2 ? -0.01791941 : cat == 3 ? 0.16338295 : 0.30000000

f_liq_w(float x) =>
    int cat = x < 0.5 ? 0 : x < 1.49 ? 1 : x < 2.49 ? 2 : x < 3.49 ? 3 : 4
    cat == 0 ? -0.11859729 : cat == 1 ? -0.02185990 : cat == 2 ? 0.18257975 : cat == 3 ? -0.05123363 : -0.21683142

f_bin_w(bool x, float w0, float w1) => x ? w1 : w0

bullICTRaw=(bullFVGRecent?6.0:0)+(bullOBTouch?6.0:0)+(inBullOTE?5.0:0)+(bullCHOCH?8.0:bullBOS?4.0:0)
bearICTRaw=(bearFVGRecent?6.0:0)+(bearOBTouch?6.0:0)+(inBearOTE?5.0:0)+(bearCHOCH?8.0:bearBOS?4.0:0)
bullICTScore=math.min(25.0,bullICTRaw)
bearICTScore=math.min(25.0,bearICTRaw)

bullMomentum=(stK>stD) and (close>bbBasis)
bearMomentum=(stK<stD) and (close<bbBasis)

baseLogit=-0.34984801

bullLogit=baseLogit+
     f_mtf_w(bullMTFCount)+f_ict_w(bullICTScore)+f_liq_w(bullLiquidityRecent)+
     f_bin_w(bullDispRecent,-0.17318643,0.10789569)+
     f_bin_w(inKillZone,0.01418554,-0.01469758)+
     f_bin_w(robustWindow,-0.06632944,-0.00004718)+
     f_bin_w(bullMomentum,-0.21156983,0.15384942)+
     f_bin_w(bullFVGRecent,-0.16703434,0.02859150)+
     f_bin_w(bullOBTouch,-0.06616043,0.08279938)+
     f_bin_w(inBullOTE,-0.02425281,0.03252337)+
     f_bin_w(bullCHOCH,-0.02038700,0.30000000)+
     f_bin_w(bullBOS,-0.02022800,0.30000000)

bearLogit=baseLogit+
     f_mtf_w(bearMTFCount)+f_ict_w(bearICTScore)+f_liq_w(bearLiquidityRecent)+
     f_bin_w(bearDispRecent,-0.17318643,0.10789569)+
     f_bin_w(inKillZone,0.01418554,-0.01469758)+
     f_bin_w(robustWindow,-0.06632944,-0.00004718)+
     f_bin_w(bearMomentum,-0.21156983,0.15384942)+
     f_bin_w(bearFVGRecent,-0.16703434,0.02859150)+
     f_bin_w(bearOBTouch,-0.06616043,0.08279938)+
     f_bin_w(inBearOTE,-0.02425281,0.03252337)+
     f_bin_w(bearCHOCH,-0.02038700,0.30000000)+
     f_bin_w(bearBOS,-0.02022800,0.30000000)

// Frozen pre-2020 empirical percentile cutoffs.
// The displayed score is a validated quality tier midpoint, not a fabricated probability.
f_cal_score(float z) =>
    z < -0.40027632 ? 30 : z < -0.23783007 ? 47 : z < -0.12664342 ? 62 : z < 0.10206356 ? 77 : 97

bullScore100=f_cal_score(bullLogit)
bearScore100=f_cal_score(bearLogit)

bullLQScore=math.min(20.0,bullLiquidityRecent*6.0)
bearLQScore=math.min(20.0,bearLiquidityRecent*6.0)
bullMTFScore=math.min(30.0,bullMTFCount*5.0)
bearMTFScore=math.min(30.0,bearMTFCount*5.0)

// ---------- Event-driven setup lock ----------
var int bullGeneration=0
var int bearGeneration=0
var int lastBullUsed=-1
var int lastBearUsed=-1
var int lastExitBar=na

newBullEvent=bullSwingSweep or bullFVG or bullBOS or bullCHOCH or bullLiquidityNow>=1.5
newBearEvent=bearSwingSweep or bearFVG or bearBOS or bearCHOCH or bearLiquidityNow>=1.5
if newBullEvent
    bullGeneration+=1
if newBearEvent
    bearGeneration+=1

justClosed=strategy.position_size==0 and strategy.position_size[1]!=0
if justClosed
    lastExitBar:=bar_index

gapOK=na(lastExitBar) or bar_index-lastExitBar>=minRearmBars
freshBull=bullGeneration>lastBullUsed
freshBear=bearGeneration>lastBearUsed

rawLong=(continuationLong or strictRevLong) and bullScore100>=minScoreTrade
rawShort=(continuationShort or strictRevShort) and bearScore100>=minScoreTrade

// Quality tiers validated by chronological walk-forward research.
// Elite context: LONG during NY-only; SHORT during London/NY overlap.
nyOnly = inNY and not inLondon
overlapSession = inNY and inLondon
eliteLong = bullScore100 >= eliteScore and nyOnly
eliteShort = bearScore100 >= eliteScore and overlapSession
sTierLong = bullScore100 >= sTierScore and bullDispRecent and eliteLong
sTierShort = bearScore100 >= sTierScore and bearDispRecent and eliteShort
longEdge=rawLong and not rawLong[1]
shortEdge=rawShort and not rawShort[1]

// ---------- BC+ breakout continuation engine ----------
// Reverse-engineered from all >=15-point M5 session expansions since 2020.
// Validation split: 2020-2023 vs 2024-2026.
// Entry: M5 breakout of prior 6 bars + recent displacement + all five higher TFs aligned
//        + EMA8/EMA20 direction + stochastic direction, London/NY sessions only.
// Management is intentionally simple: dynamic ATR/session TP/SL, no early BE/trailing.
bcLondonOnly = inLondon and not inNY
bcNYOnly = inNY and not inLondon
bcOverlap = inLondon and inNY
bcSessionOK = (bcAllowLondonOnly and bcLondonOnly) or (bcAllowNYOnly and bcNYOnly) or (bcAllowOverlap and bcOverlap)
bcTFOK = not bcOnlyM5 or timeframe.period == "5"
bcEMA8 = ta.ema(close, 8)
bcBreakLong = close > ta.highest(high[1], 6)
bcBreakShort = close < ta.lowest(low[1], 6)
bcHTFLong = tf15 == 1 and tf30 == 1 and tf60 == 1 and tf120 == 1 and tf240 == 1
bcHTFShort = tf15 == -1 and tf30 == -1 and tf60 == -1 and tf120 == -1 and tf240 == -1
bcLongRaw = enableBCPlus and bcTFOK and bcSessionOK and bcOverlapLongOK and bcBreakLong and bullDispRecent and bcHTFLong and bcEMA8 > bbBasis and stK > stD
bcShortRaw = enableBCPlus and bcTFOK and bcSessionOK and bcOverlapShortOK and bcBreakShort and bearDispRecent and bcHTFShort and bcEMA8 < bbBasis and stK < stD
bcLongEdge = bcLongRaw and not bcLongRaw[1]
bcShortEdge = bcShortRaw and not bcShortRaw[1]

bcTPMult = bcNYOnly ? bcNYMult : bcOverlap ? bcOverlapMult : 1.0
bcSignalSL = math.min(bcSLCap, math.max(bcSLFloor, atr14 * bcSLATR))
bcSignalTP = math.max(bcTPFloor, atr14 * bcTPATR * bcTPMult)

// ---------- Liquidity target selection ----------
f_nearest_above(float entry, float minDist) =>
    float t = na
    if not na(lastSwingHigh) and lastSwingHigh-entry >= minDist
        t := lastSwingHigh
    if not na(pdHigh) and pdHigh-entry >= minDist and (na(t) or pdHigh<t)
        t := pdHigh
    if not na(pwHigh) and pwHigh-entry >= minDist and (na(t) or pwHigh<t)
        t := pwHigh
    if not na(d30High) and d30High-entry >= minDist and (na(t) or d30High<t)
        t := d30High
    if not na(prevAsiaHigh) and prevAsiaHigh-entry >= minDist and (na(t) or prevAsiaHigh<t)
        t := prevAsiaHigh
    t

f_nearest_below(float entry, float minDist) =>
    float t = na
    if not na(lastSwingLow) and entry-lastSwingLow >= minDist
        t := lastSwingLow
    if not na(pdLow) and entry-pdLow >= minDist and (na(t) or pdLow>t)
        t := pdLow
    if not na(pwLow) and entry-pwLow >= minDist and (na(t) or pwLow>t)
        t := pwLow
    if not na(d30Low) and entry-d30Low >= minDist and (na(t) or d30Low>t)
        t := d30Low
    if not na(prevAsiaLow) and entry-prevAsiaLow >= minDist and (na(t) or prevAsiaLow>t)
        t := prevAsiaLow
    t

// ---------- Dynamic management ----------
var float peak=na
var float trough=na
var bool protected=false
var bool reversalTrade=false
var float activeLiqTarget=na
var bool liquidityTaken=false
var bool bcTrade=false
var float bcActiveSL=na
var float bcActiveTP=na
var int bcActiveMaxHold=na


if strategy.position_size==0 and gapOK
    peak:=na
    trough:=na
    protected:=false
    liquidityTaken:=false
    activeLiqTarget:=na
    bcTrade:=false
    bcActiveSL:=na
    bcActiveTP:=na
    bcActiveMaxHold:=na
    if bcLongEdge
        bcTrade:=true
        reversalTrade:=false
        bcActiveSL:=bcSignalSL
        bcActiveTP:=bcSignalTP
        bcActiveMaxHold:=bcSignalMaxHold
        strategy.entry("BC+ BUY",strategy.long)
    else if bcShortEdge
        bcTrade:=true
        reversalTrade:=false
        bcActiveSL:=bcSignalSL
        bcActiveTP:=bcSignalTP
        bcActiveMaxHold:=bcSignalMaxHold
        strategy.entry("BC+ SELL",strategy.short)
    else if longEdge and freshBull
        reversalTrade:=strictRevLong and not continuationLong
        strategy.entry("BUY",strategy.long)
        activeLiqTarget:=f_nearest_above(close,liqTargetMinDist)
        lastBullUsed:=bullGeneration
    else if shortEdge and freshBear
        reversalTrade:=strictRevShort and not continuationShort
        strategy.entry("SELL",strategy.short)
        activeLiqTarget:=f_nearest_below(close,liqTargetMinDist)
        lastBearUsed:=bearGeneration

if strategy.position_size>0
    if bcTrade
        float bcLongStop=strategy.position_avg_price-bcActiveSL
        float bcLongTP=strategy.position_avg_price+bcActiveTP
        strategy.exit("BC+ BUY EXIT","BC+ BUY",stop=bcLongStop,limit=bcLongTP)
        if strategy.opentrades>0 and bar_index-strategy.opentrades.entry_bar_index(0)>=bcActiveMaxHold
            strategy.close("BC+ BUY",comment="BC+ max hold")
    else
        peak:=na(peak)?high:math.max(peak,high)
        float mfeNow=peak-strategy.position_avg_price
        float activeEmergency=reversalTrade?reversalEmergency:emergencyStop
        float activeProtect=reversalTrade?reversalProtect:protectTrigger
        protected:=protected or mfeNow>=activeProtect
        liquidityTaken:=liquidityTaken or (not na(activeLiqTarget) and high>=activeLiqTarget)
        float trailNow=reversalTrade?reversalTrailATR:trailATR
        if not reversalTrade
            trailNow:=mfeNow>=trailTier2?trailATR3:mfeNow>=trailTier1?trailATR2:trailATR
        if liquidityTaken
            trailNow:=liqTrailATR
        float longStop=strategy.position_avg_price-activeEmergency
        if protected
            longStop:=math.max(strategy.position_avg_price,peak-atr14*trailNow)
        strategy.exit("BUY PROTECT","BUY",stop=longStop)
        if bearCHOCH or (close<bbBasis and stK<stD)
            strategy.close("BUY",comment="Structure exit")
        if strategy.opentrades>0 and bar_index-strategy.opentrades.entry_bar_index(0)>=maxHoldBars
            strategy.close("BUY",comment="Max hold exit")

if strategy.position_size<0
    if bcTrade
        float bcShortStop=strategy.position_avg_price+bcActiveSL
        float bcShortTP=strategy.position_avg_price-bcActiveTP
        strategy.exit("BC+ SELL EXIT","BC+ SELL",stop=bcShortStop,limit=bcShortTP)
        if strategy.opentrades>0 and bar_index-strategy.opentrades.entry_bar_index(0)>=bcActiveMaxHold
            strategy.close("BC+ SELL",comment="BC+ max hold")
    else
        trough:=na(trough)?low:math.min(trough,low)
        float mfeNowS=strategy.position_avg_price-trough
        float activeEmergencyS=reversalTrade?reversalEmergency:emergencyStop
        float activeProtectS=reversalTrade?reversalProtect:protectTrigger
        protected:=protected or mfeNowS>=activeProtectS
        liquidityTaken:=liquidityTaken or (not na(activeLiqTarget) and low<=activeLiqTarget)
        float trailNowS=reversalTrade?reversalTrailATR:trailATR
        if not reversalTrade
            trailNowS:=mfeNowS>=trailTier2?trailATR3:mfeNowS>=trailTier1?trailATR2:trailATR
        if liquidityTaken
            trailNowS:=liqTrailATR
        float shortStop=strategy.position_avg_price+activeEmergencyS
        if protected
            shortStop:=math.min(strategy.position_avg_price,trough+atr14*trailNowS)
        strategy.exit("SELL PROTECT","SELL",stop=shortStop)
        if bullCHOCH or (close>bbBasis and stK>stD)
            strategy.close("SELL",comment="Structure exit")
        if strategy.opentrades>0 and bar_index-strategy.opentrades.entry_bar_index(0)>=maxHoldBars
            strategy.close("SELL",comment="Max hold exit")

// ---------- Pre-expansion >=15 Gold points (M5 research layer) ----------
// Trained on 2020-2023 and checked on 2024-2026. This is a WATCH/TRIGGER layer,
// not a replacement for the core strategy. It estimates conditions 5-15 minutes
// before a >=15-point session expansion, then requires an M5 directional trigger.
gPre = "Pre-Expansion 15pt"
enablePreExpansion = input.bool(true, "Enable pre-expansion layer", group=gPre)
preExpansionThreshold = input.float(0.875, "Pre-expansion probability threshold", minval=0.50, maxval=0.99, step=0.005, group=gPre)
preExpansionWindow = input.int(3, "Trigger window (M5 bars)", minval=1, maxval=6, group=gPre)
preExpansionCooldown = input.int(12, "Pre-expansion cooldown (M5 bars)", minval=1, group=gPre)
enableTimePrior = input.bool(true, "Use validated session-time prior", group=gPre)
timePriorStrength = input.float(0.22, "Time-prior strength", minval=0.0, maxval=0.50, step=0.01, group=gPre)

preEma8 = ta.ema(close, 8)
preEma20 = ta.ema(close, 20)
preEma50 = ta.ema(close, 50)
preAtrMean100 = ta.sma(atr14, 100)
preAtrRel = atr14 / math.max(preAtrMean100, syminfo.mintick)
preRange12ATR = (ta.highest(high[1], 12) - ta.lowest(low[1], 12)) / math.max(atr14, syminfo.mintick)
preRange36ATR = (ta.highest(high[1], 36) - ta.lowest(low[1], 36)) / math.max(atr14, syminfo.mintick)
preBBWidth = (4.4 * bbDev) / math.max(close, syminfo.mintick)

preBullTrend = (tf15 == 1 ? 1.0 : 0.0) + (tf30 == 1 ? 1.0 : 0.0) + (tf60 == 1 ? 1.0 : 0.0) + (tf120 == 1 ? 1.0 : 0.0) + (tf240 == 1 ? 1.0 : 0.0)
preBearTrend = (tf15 == -1 ? 1.0 : 0.0) + (tf30 == -1 ? 1.0 : 0.0) + (tf60 == -1 ? 1.0 : 0.0) + (tf120 == -1 ? 1.0 : 0.0) + (tf240 == -1 ? 1.0 : 0.0)

preBullEMA = preEma8 > preEma20 and preEma20 > preEma50 ? 1.0 : 0.0
preBearEMA = preEma8 < preEma20 and preEma20 < preEma50 ? 1.0 : 0.0
preBullStoch = stK > stD and stK < 80 ? 1.0 : 0.0
preBearStoch = stK < stD and stK > 20 ? 1.0 : 0.0
preBullFVG = ta.barssince(bullFVG) >= 0 and ta.barssince(bullFVG) <= 6 ? 1.0 : 0.0
preBearFVG = ta.barssince(bearFVG) >= 0 and ta.barssince(bearFVG) <= 6 ? 1.0 : 0.0
preBullDisp = ta.barssince(bullDisp) >= 0 and ta.barssince(bullDisp) <= 6 ? 1.0 : 0.0
preBearDisp = ta.barssince(bearDisp) >= 0 and ta.barssince(bearDisp) <= 6 ? 1.0 : 0.0
preBullBOS = ta.barssince(bullBOS) >= 0 and ta.barssince(bullBOS) <= 6 ? 1.0 : 0.0
preBearBOS = ta.barssince(bearBOS) >= 0 and ta.barssince(bearBOS) <= 6 ? 1.0 : 0.0
preBullCHOCH = ta.barssince(bullCHOCH) >= 0 and ta.barssince(bullCHOCH) <= 6 ? 1.0 : 0.0
preBearCHOCH = ta.barssince(bearCHOCH) >= 0 and ta.barssince(bearCHOCH) <= 6 ? 1.0 : 0.0
preBullSweep = (sweepBelow(pdLow) or sweepBelow(prevAsiaLow)) ? 1.0 : 0.0
preBearSweep = (sweepAbove(pdHigh) or sweepAbove(prevAsiaHigh)) ? 1.0 : 0.0

f_z(float x, float mean, float scale) => (x - mean) / scale

// Session-time prior derived from all >=15-point M5 expansions since 2020.
// Only windows with lift >1 in BOTH 2020-23 and 2024-26 are used.
// Strongest: London 08:00 (~4.1x OOS) and NY 08:00 (~3.2x OOS).
f_pre_time_lift() =>
    float lift = 1.0
    if inLondon
        lift := lonMinutes >= 480 and lonMinutes < 495 ? 4.087 :
                lonMinutes >= 495 and lonMinutes < 510 ? 1.416 :
                lonMinutes >= 540 and lonMinutes < 555 ? 1.188 :
                lonMinutes >= 570 and lonMinutes < 585 ? 1.290 :
                lonMinutes >= 600 and lonMinutes < 615 ? 1.239 :
                lonMinutes >= 660 and lonMinutes < 675 ? 1.158 :
                lonMinutes >= 930 and lonMinutes < 945 ? 1.042 : lift
    if inNY
        float nyLift = nyMinutes >= 480 and nyMinutes < 495 ? 3.236 :
                       nyMinutes >= 495 and nyMinutes < 510 ? 1.525 :
                       nyMinutes >= 600 and nyMinutes < 615 ? 1.283 :
                       nyMinutes >= 630 and nyMinutes < 645 ? 1.477 :
                       nyMinutes >= 660 and nyMinutes < 675 ? 1.114 :
                       nyMinutes >= 690 and nyMinutes < 705 ? 1.053 :
                       nyMinutes >= 690 and nyMinutes < 720 ? 1.975 :
                       nyMinutes >= 720 and nyMinutes < 735 ? 1.417 :
                       nyMinutes >= 735 and nyMinutes < 750 ? 1.181 :
                       nyMinutes >= 750 and nyMinutes < 765 ? 1.557 :
                       nyMinutes >= 765 and nyMinutes < 780 ? 1.115 :
                       nyMinutes >= 780 and nyMinutes < 795 ? 1.352 : 1.0
        lift := math.max(lift, nyLift)
    lift

preTimeLift = f_pre_time_lift()
preTimeBonus = enableTimePrior ? timePriorStrength * math.log(math.max(preTimeLift, 1.0)) : 0.0

preLogitLong =
     -0.30167756 +
     0.045217 * f_z(preBullTrend, 2.085752, 1.891226) +
    -0.372655 * f_z(preBullEMA, 0.400131, 0.489925) +
    -0.363419 * f_z(preBullStoch, 0.363201, 0.480922) +
    -0.213174 * f_z(preBullFVG, 0.446385, 0.497117) +
     0.040755 * f_z(preBullDisp, 0.366611, 0.481879) +
    -0.102900 * f_z(preBullBOS, 0.140064, 0.347053) +
    -0.174379 * f_z(preBullCHOCH, 0.108682, 0.311239) +
    -0.046001 * f_z(preBullSweep, 0.042031, 0.200659) +
     0.099713 * f_z(preAtrRel, 1.205161, 0.345416) +
    -0.067827 * f_z(preRange12ATR, 3.544861, 1.119371) +
    -0.259205 * f_z(preRange36ATR, 6.245262, 1.891950) +
     0.439650 * f_z(preBBWidth, 0.004024, 0.003337)

preLogitShort =
     -0.31252108 +
     0.199020 * f_z(preBearTrend, 1.773760, 1.821162) +
    -0.392645 * f_z(preBearEMA, 0.380496, 0.485509) +
    -0.335645 * f_z(preBearStoch, 0.375918, 0.484359) +
    -0.272140 * f_z(preBearFVG, 0.433233, 0.495522) +
    -0.058517 * f_z(preBearDisp, 0.364845, 0.481387) +
    -0.059382 * f_z(preBearBOS, 0.129345, 0.335582) +
    -0.124004 * f_z(preBearCHOCH, 0.108426, 0.310918) +
    -0.026478 * f_z(preBearSweep, 0.042920, 0.202676) +
     0.097837 * f_z(preAtrRel, 1.205161, 0.345416) +
    -0.072797 * f_z(preRange12ATR, 3.544861, 1.119371) +
    -0.216568 * f_z(preRange36ATR, 6.245262, 1.891950) +
     0.479251 * f_z(preBBWidth, 0.004024, 0.003337)

preProbLong = 1.0 / (1.0 + math.exp(-(preLogitLong + preTimeBonus)))
preProbShort = 1.0 / (1.0 + math.exp(-(preLogitShort + preTimeBonus)))
preSessionOK = inLondon or inNY

var int preWarnLongBar = na
var int preWarnShortBar = na
var int preLastSignalBar = na

preWarnLong = enablePreExpansion and timeframe.period == "5" and preSessionOK and preProbLong >= preExpansionThreshold and preProbLong > preProbShort and nz(preProbLong[1], 0) < preExpansionThreshold
preWarnShort = enablePreExpansion and timeframe.period == "5" and preSessionOK and preProbShort >= preExpansionThreshold and preProbShort > preProbLong and nz(preProbShort[1], 0) < preExpansionThreshold

if preWarnLong
    preWarnLongBar := bar_index
if preWarnShort
    preWarnShortBar := bar_index

preLongTriggerRaw = bullDisp or close > ta.highest(high[1], 3)
preShortTriggerRaw = bearDisp or close < ta.lowest(low[1], 3)
preCooldownOK = na(preLastSignalBar) or bar_index - preLastSignalBar >= preExpansionCooldown

pre15Long = enablePreExpansion and preCooldownOK and not na(preWarnLongBar) and bar_index > preWarnLongBar and bar_index - preWarnLongBar <= preExpansionWindow and preLongTriggerRaw
pre15Short = enablePreExpansion and preCooldownOK and not na(preWarnShortBar) and bar_index > preWarnShortBar and bar_index - preWarnShortBar <= preExpansionWindow and preShortTriggerRaw

if pre15Long or pre15Short
    preLastSignalBar := bar_index
    preWarnLongBar := na
    preWarnShortBar := na

plotshape(preWarnLong, "PRE15 WATCH LONG", shape.circle, location.belowbar, color=color.new(color.aqua, 15), size=size.tiny, text="15?")
plotshape(preWarnShort, "PRE15 WATCH SHORT", shape.circle, location.abovebar, color=color.new(color.orange, 15), size=size.tiny, text="15?")
plotshape(pre15Long, "PRE15 LONG TRIGGER", shape.triangleup, location.belowbar, color=color.aqua, size=size.small, text="15L")
plotshape(pre15Short, "PRE15 SHORT TRIGGER", shape.triangledown, location.abovebar, color=color.orange, size=size.small, text="15S")

// Overlap time filter validation:
// unfiltered overlap: PF 1.475 -> 1.611
// filtered overlap:   PF 1.745 -> 1.805
// LONG validated windows (NY time): 08:00-08:30, 09:00-11:00, 11:30-12:00
// SHORT validated window (NY time): 11:00-11:30
// // BC+ segment validation 2020-23 vs 2024-26:
// London-only PF 1.269 -> 0.987 (disabled by default)
// NY-only PF 1.186 -> 1.606
// Overlap PF 1.367 -> 1.663 (strongest segment)
// ---------- BC+ visuals ----------
bcLongPlotTP = strategy.position_size > 0 and bcTrade ? strategy.position_avg_price + bcActiveTP : na
bcLongPlotSL = strategy.position_size > 0 and bcTrade ? strategy.position_avg_price - bcActiveSL : na
bcShortPlotTP = strategy.position_size < 0 and bcTrade ? strategy.position_avg_price - bcActiveTP : na
bcShortPlotSL = strategy.position_size < 0 and bcTrade ? strategy.position_avg_price + bcActiveSL : na
plot(showBCLevels ? (not na(bcLongPlotTP) ? bcLongPlotTP : bcShortPlotTP) : na, "BC+ TP", color=color.new(color.lime,0), linewidth=2, style=plot.style_linebr)
plot(showBCLevels ? (not na(bcLongPlotSL) ? bcLongPlotSL : bcShortPlotSL) : na, "BC+ SL", color=color.new(color.red,0), linewidth=2, style=plot.style_linebr)
plotshape(bcLongEdge and gapOK, "BC+ BUY", shape.labelup, location.belowbar, color=color.new(color.aqua,0), textcolor=color.black, text="BC+", size=size.small)
plotshape(bcShortEdge and gapOK, "BC+ SELL", shape.labeldown, location.abovebar, color=color.new(color.orange,0), textcolor=color.black, text="BC+", size=size.small)

// ---------- Visual signals ----------
isBullAPlus=bullScore100>=aPlusScore or continuationAPlusBull
isBearAPlus=bearScore100>=aPlusScore or continuationAPlusBear
plotshape(longEdge and gapOK and freshBull, "BUY", shape.labelup, location.belowbar,
     color=isBullAPlus?color.lime:color.green,textcolor=isBullAPlus?color.black:color.white,
     text=sTierLong?"S BUY":eliteLong?"ELITE BUY":isBullAPlus?"A+ BUY":"BUY",size=size.small)
plotshape(shortEdge and gapOK and freshBear, "SELL", shape.labeldown, location.abovebar,
     color=isBearAPlus?color.fuchsia:color.red,textcolor=color.white,
     text=sTierShort?"S SELL":eliteShort?"ELITE SELL":isBearAPlus?"A+ SELL":"SELL",size=size.small)
plotshape(strictRevLong, "REV BUY", shape.circle, location.belowbar, color=color.aqua, size=size.tiny, text="REV")
plotshape(strictRevShort, "REV SELL", shape.circle, location.abovebar, color=color.yellow, size=size.tiny, text="REV")
plotshape(eliteLong and not sTierLong, "ELITE LONG", shape.diamond, location.belowbar, color=color.new(color.green,0), size=size.tiny, text="E")
plotshape(eliteShort and not sTierShort, "ELITE SHORT", shape.diamond, location.abovebar, color=color.new(color.red,0), size=size.tiny, text="E")
plotshape(sTierLong, "S-TIER LONG", shape.star, location.belowbar, color=color.new(color.lime,0), size=size.small, text="S")
plotshape(sTierShort, "S-TIER SHORT", shape.star, location.abovebar, color=color.new(color.fuchsia,0), size=size.small, text="S")

if showScoreLabels and (longEdge or shortEdge)
    label.new(bar_index,longEdge?low:high,
       (longEdge?"BUY ":"SELL ")+str.tostring(longEdge?bullScore100:bearScore100)+"/100",
       style=longEdge?label.style_label_up:label.style_label_down,
       color=longEdge?color.new(color.green,15):color.new(color.red,15),
       textcolor=color.white,size=size.tiny)

// ---------- Dashboard ----------
var table dash=table.new(position.top_right,2,13,border_width=1)
if barstate.islast
    table.cell(dash,0,0,"XAUUSD",bgcolor=color.black,text_color=color.white)
    table.cell(dash,1,0,"INTER v3",bgcolor=color.black,text_color=color.white)
    table.cell(dash,0,1,"H4/H1 Bias")
    table.cell(dash,1,1,biasBull?"BULL":biasBear?"BEAR":"MIXED")
    table.cell(dash,0,2,"H2/M30")
    table.cell(dash,1,2,confirmBull?"BULL":confirmBear?"BEAR":"WAIT")
    table.cell(dash,0,3,"M15/M5")
    table.cell(dash,1,3,triggerBull?"BULL":triggerBear?"BEAR":"WAIT")
    table.cell(dash,0,4,"Bull score")
    table.cell(dash,1,4,str.tostring(bullScore100)+"/100",
       bgcolor=bullScore100>=aPlusScore?color.new(color.green,20):color.new(color.gray,80),text_color=color.white)
    table.cell(dash,0,5,"Bear score")
    table.cell(dash,1,5,str.tostring(bearScore100)+"/100",
       bgcolor=bearScore100>=aPlusScore?color.new(color.red,20):color.new(color.gray,80),text_color=color.white)
    table.cell(dash,0,6,"Liquidity B/S")
    table.cell(dash,1,6,str.tostring(bullLiquidityRecent,"#.##")+" / "+str.tostring(bearLiquidityRecent,"#.##"))
    table.cell(dash,0,7,"ICT B/S")
    table.cell(dash,1,7,str.tostring(bullICTScore,"#")+" / "+str.tostring(bearICTScore,"#"))
    table.cell(dash,0,8,"MTF B/S")
    table.cell(dash,1,8,str.tostring(bullMTFCount)+" / "+str.tostring(bearMTFCount))
    table.cell(dash,0,9,"Setup")
    table.cell(dash,1,9,strictRevLong or strictRevShort?"REV":continuationAPlusBull or continuationAPlusBear?"A+ CONT":continuationLong or continuationShort?"CONT":"NONE")
    table.cell(dash,0,10,"Lock")
    table.cell(dash,1,10,gapOK?"READY":"LOCKED")
    table.cell(dash,0,11,"Tier")
    table.cell(dash,1,11,sTierLong or sTierShort?"S-TIER":eliteLong or eliteShort?"ELITE":bullScore100>=aPlusScore or bearScore100>=aPlusScore?"A+":"STANDARD")
    table.cell(dash,0,12,"Decision")
    table.cell(dash,1,12,longEdge and gapOK and freshBull?"BUY":shortEdge and gapOK and freshBear?"SELL":"WAIT",
       bgcolor=longEdge and gapOK and freshBull?color.new(color.green,20):shortEdge and gapOK and freshBear?color.new(color.red,20):color.new(color.gray,80),
       text_color=color.white)

alertcondition(bcLongEdge and gapOK,"XAUUSD BC+ BUY","XAUUSD BC+ breakout-continuation BUY")
alertcondition(bcShortEdge and gapOK,"XAUUSD BC+ SELL","XAUUSD BC+ breakout-continuation SELL")
alertcondition(longEdge and gapOK and freshBull,"XAUUSD BUY","XAUUSD Inter-style BUY")
alertcondition(shortEdge and gapOK and freshBear,"XAUUSD SELL","XAUUSD Inter-style SELL")
alertcondition(continuationAPlusBull,"XAUUSD A+ BUY","XAUUSD A+ continuation BUY")
alertcondition(continuationAPlusBear,"XAUUSD A+ SELL","XAUUSD A+ continuation SELL")
alertcondition(strictRevLong,"XAUUSD REV BUY","XAUUSD strict reversal BUY")
alertcondition(strictRevShort,"XAUUSD REV SELL","XAUUSD strict reversal SELL")
alertcondition(eliteLong,"XAUUSD ELITE BUY","XAUUSD Elite BUY score >= 90")
alertcondition(eliteShort,"XAUUSD ELITE SELL","XAUUSD Elite SELL score >= 90")
alertcondition(sTierLong,"XAUUSD S-TIER BUY","XAUUSD S-tier BUY score >= 96 + displacement")
alertcondition(sTierShort,"XAUUSD S-TIER SELL","XAUUSD S-tier SELL score >= 96 + displacement")

alertcondition(preWarnLong,"XAUUSD PRE15 WATCH LONG","XAUUSD possible >=15-point LONG expansion developing")
alertcondition(preWarnShort,"XAUUSD PRE15 WATCH SHORT","XAUUSD possible >=15-point SHORT expansion developing")
alertcondition(pre15Long,"XAUUSD PRE15 LONG","XAUUSD PRE15 LONG trigger after pre-expansion warning")
alertcondition(pre15Short,"XAUUSD PRE15 SHORT","XAUUSD PRE15 SHORT trigger after pre-expansion warning")
