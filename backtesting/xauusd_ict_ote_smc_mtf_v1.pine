//@version=6
indicator("XAUUSD ICT / OTE / SMC MTF System", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=200)

// =====================================================
// XAUUSD ICT / OTE / SMC visual system
// Causal design: confirmed pivots + request.security(..., lookahead_off)
// Sessions: London + New York
// =====================================================

// ---------- Inputs ----------
groupSession = "Sessions"
showLondon = input.bool(true, "Show London", group=groupSession)
showNY = input.bool(true, "Show New York", group=groupSession)
london = input.session("0800-1700", "London session", group=groupSession)
newYork = input.session("0800-1700", "New York session", group=groupSession)
londonTZ = input.string("Europe/London", "London timezone", group=groupSession)
nyTZ = input.string("America/New_York", "New York timezone", group=groupSession)

groupStruct = "SMC / ICT Structure"
pivotLen = input.int(3, "Confirmed swing length", minval=1, maxval=20, group=groupStruct)
showBOS = input.bool(true, "BOS", group=groupStruct)
showCHOCH = input.bool(true, "CHoCH", group=groupStruct)
showFVG = input.bool(true, "Fair Value Gaps", group=groupStruct)
showOTE = input.bool(true, "OTE 62%-79%", group=groupStruct)
showEQ = input.bool(true, "Equilibrium 50%", group=groupStruct)

groupLevels = "Liquidity Levels"
showPrevSessions = input.bool(true, "Previous session highs/lows", group=groupLevels)
show30D = input.bool(true, "30-day high/low", group=groupLevels)
showPD = input.bool(true, "Previous day high/low", group=groupLevels)
showPW = input.bool(true, "Previous week high/low", group=groupLevels)

groupTrend = "Trend Lines"
showTrendSession = input.bool(true, "Current-session trend", group=groupTrend)
showTrend1M = input.bool(true, "1-month trend", group=groupTrend)
showTrend3M = input.bool(true, "3-month trend", group=groupTrend)
showTrend6M = input.bool(true, "6-month trend", group=groupTrend)
trendLenSession = input.int(24, "Session regression bars", minval=5, group=groupTrend)
trendLen1M = input.int(21, "1M regression days", minval=5, group=groupTrend)
trendLen3M = input.int(63, "3M regression days", minval=20, group=groupTrend)
trendLen6M = input.int(126, "6M regression days", minval=40, group=groupTrend)

groupVisual = "Visuals"
showDashboard = input.bool(true, "Dashboard", group=groupVisual)
showSessionBg = input.bool(true, "Session background", group=groupVisual)

// ---------- Session state ----------
inLondon = not na(time(timeframe.period, london, londonTZ))
inNY = not na(time(timeframe.period, newYork, nyTZ))
newLondon = inLondon and not inLondon[1]
newNY = inNY and not inNY[1]
endLondon = not inLondon and inLondon[1]
endNY = not inNY and inNY[1]

bgcolor(showSessionBg and inLondon ? color.new(color.blue, 92) : na)
bgcolor(showSessionBg and inNY ? color.new(color.orange, 92) : na)

// ---------- Track current/previous session liquidity ----------
var float londonHigh = na
var float londonLow = na
var float prevLondonHigh = na
var float prevLondonLow = na

if newLondon
    londonHigh := high
    londonLow := low
else if inLondon
    londonHigh := math.max(nz(londonHigh, high), high)
    londonLow := math.min(nz(londonLow, low), low)
if endLondon
    prevLondonHigh := londonHigh
    prevLondonLow := londonLow

var float nyHigh = na
var float nyLow = na
var float prevNYHigh = na
var float prevNYLow = na

if newNY
    nyHigh := high
    nyLow := low
else if inNY
    nyHigh := math.max(nz(nyHigh, high), high)
    nyLow := math.min(nz(nyLow, low), low)
if endNY
    prevNYHigh := nyHigh
    prevNYLow := nyLow

plot(showLondon and inLondon ? londonHigh : na, "London High", color=color.new(color.blue, 10), linewidth=2, style=plot.style_linebr)
plot(showLondon and inLondon ? londonLow : na, "London Low", color=color.new(color.blue, 10), linewidth=2, style=plot.style_linebr)
plot(showNY and inNY ? nyHigh : na, "NY High", color=color.new(color.orange, 10), linewidth=2, style=plot.style_linebr)
plot(showNY and inNY ? nyLow : na, "NY Low", color=color.new(color.orange, 10), linewidth=2, style=plot.style_linebr)

plot(showPrevSessions ? prevLondonHigh : na, "Prev London High", color=color.new(color.blue, 45), linewidth=1, style=plot.style_stepline)
plot(showPrevSessions ? prevLondonLow : na, "Prev London Low", color=color.new(color.blue, 45), linewidth=1, style=plot.style_stepline)
plot(showPrevSessions ? prevNYHigh : na, "Prev NY High", color=color.new(color.orange, 45), linewidth=1, style=plot.style_stepline)
plot(showPrevSessions ? prevNYLow : na, "Prev NY Low", color=color.new(color.orange, 45), linewidth=1, style=plot.style_stepline)

// ---------- Higher-timeframe liquidity ----------
pdHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
pdLow = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_off)
pwHigh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_off)
pwLow = request.security(syminfo.tickerid, "W", low[1], lookahead=barmerge.lookahead_off)

d30High = request.security(syminfo.tickerid, "D", ta.highest(high[1], 30), lookahead=barmerge.lookahead_off)
d30Low = request.security(syminfo.tickerid, "D", ta.lowest(low[1], 30), lookahead=barmerge.lookahead_off)

plot(showPD ? pdHigh : na, "PDH", color=color.new(color.fuchsia, 25), linewidth=1, style=plot.style_stepline)
plot(showPD ? pdLow : na, "PDL", color=color.new(color.fuchsia, 25), linewidth=1, style=plot.style_stepline)
plot(showPW ? pwHigh : na, "PWH", color=color.new(color.purple, 30), linewidth=1, style=plot.style_stepline)
plot(showPW ? pwLow : na, "PWL", color=color.new(color.purple, 30), linewidth=1, style=plot.style_stepline)
plot(show30D ? d30High : na, "30D High", color=color.new(color.red, 20), linewidth=2, style=plot.style_stepline)
plot(show30D ? d30Low : na, "30D Low", color=color.new(color.green, 20), linewidth=2, style=plot.style_stepline)

// ---------- Confirmed structure ----------
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float lastSwingHigh = na
var float lastSwingLow = na
var float prevSwingHigh = na
var float prevSwingLow = na
var int structure = 0

if not na(ph)
    prevSwingHigh := lastSwingHigh
    lastSwingHigh := ph
if not na(pl)
    prevSwingLow := lastSwingLow
    lastSwingLow := pl

bullBreak = not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
bearBreak = not na(lastSwingLow) and close < lastSwingLow and close[1] >= lastSwingLow

bullCHOCH = bullBreak and structure == -1
bearCHOCH = bearBreak and structure == 1
bullBOS = bullBreak and structure != -1
bearBOS = bearBreak and structure != 1

if bullBreak
    structure := 1
if bearBreak
    structure := -1

if showBOS and bullBOS
    label.new(bar_index, low, "BOS ↑", style=label.style_label_up, textcolor=color.white, color=color.new(color.green, 10), size=size.tiny)
if showBOS and bearBOS
    label.new(bar_index, high, "BOS ↓", style=label.style_label_down, textcolor=color.white, color=color.new(color.red, 10), size=size.tiny)
if showCHOCH and bullCHOCH
    label.new(bar_index, low, "CHoCH ↑", style=label.style_label_up, textcolor=color.white, color=color.new(color.teal, 0), size=size.small)
if showCHOCH and bearCHOCH
    label.new(bar_index, high, "CHoCH ↓", style=label.style_label_down, textcolor=color.white, color=color.new(color.maroon, 0), size=size.small)

// ---------- ICT OTE ----------
var float impulseLow = na
var float impulseHigh = na

if structure == 1 and not na(lastSwingLow) and not na(lastSwingHigh)
    impulseLow := lastSwingLow
    impulseHigh := lastSwingHigh
if structure == -1 and not na(lastSwingLow) and not na(lastSwingHigh)
    impulseLow := lastSwingLow
    impulseHigh := lastSwingHigh

rangeSwing = not na(impulseHigh) and not na(impulseLow) ? impulseHigh - impulseLow : na

bullOTE62 = structure == 1 ? impulseHigh - rangeSwing * 0.62 : na
bullOTE79 = structure == 1 ? impulseHigh - rangeSwing * 0.79 : na
bearOTE62 = structure == -1 ? impulseLow + rangeSwing * 0.62 : na
bearOTE79 = structure == -1 ? impulseLow + rangeSwing * 0.79 : na
eq = not na(rangeSwing) ? impulseLow + rangeSwing * 0.50 : na

pBull62 = plot(showOTE and structure == 1 ? bullOTE62 : na, "Bull OTE 62", color=color.new(color.green, 20), style=plot.style_linebr)
pBull79 = plot(showOTE and structure == 1 ? bullOTE79 : na, "Bull OTE 79", color=color.new(color.green, 20), style=plot.style_linebr)
fill(pBull62, pBull79, color=color.new(color.green, 88), title="Bull OTE Zone")

pBear62 = plot(showOTE and structure == -1 ? bearOTE62 : na, "Bear OTE 62", color=color.new(color.red, 20), style=plot.style_linebr)
pBear79 = plot(showOTE and structure == -1 ? bearOTE79 : na, "Bear OTE 79", color=color.new(color.red, 20), style=plot.style_linebr)
fill(pBear62, pBear79, color=color.new(color.red, 88), title="Bear OTE Zone")

plot(showEQ ? eq : na, "Equilibrium 50%", color=color.new(color.gray, 25), linewidth=1, style=plot.style_linebr)

inBullOTE = structure == 1 and not na(bullOTE62) and low <= bullOTE62 and high >= bullOTE79
inBearOTE = structure == -1 and not na(bearOTE62) and high >= bearOTE62 and low <= bearOTE79

// ---------- Fair Value Gaps ----------
bullFVG = showFVG and low > high[2]
bearFVG = showFVG and high < low[2]

if bullFVG
    box.new(bar_index-2, low, bar_index+20, high[2], bgcolor=color.new(color.green, 90), border_color=color.new(color.green, 55), extend=extend.none)
if bearFVG
    box.new(bar_index-2, low[2], bar_index+20, high, bgcolor=color.new(color.red, 90), border_color=color.new(color.red, 55), extend=extend.none)

// ---------- Liquidity sweeps ----------
sweepPDH = high > pdHigh and close < pdHigh
sweepPDL = low < pdLow and close > pdLow
sweep30H = high > d30High and close < d30High
sweep30L = low < d30Low and close > d30Low
sweepPrevLondonH = not na(prevLondonHigh) and high > prevLondonHigh and close < prevLondonHigh
sweepPrevLondonL = not na(prevLondonLow) and low < prevLondonLow and close > prevLondonLow
sweepPrevNYH = not na(prevNYHigh) and high > prevNYHigh and close < prevNYHigh
sweepPrevNYL = not na(prevNYLow) and low < prevNYLow and close > prevNYLow

bullSweep = sweepPDL or sweep30L or sweepPrevLondonL or sweepPrevNYL
bearSweep = sweepPDH or sweep30H or sweepPrevLondonH or sweepPrevNYH

plotshape(bullSweep, "Bullish liquidity sweep", shape.triangleup, location.belowbar, color=color.new(color.aqua, 0), size=size.tiny, text="LQ")
plotshape(bearSweep, "Bearish liquidity sweep", shape.triangledown, location.abovebar, color=color.new(color.yellow, 0), size=size.tiny, text="LQ")

// ---------- Trend lines ----------
// Current chart/session regression
sessionActive = inLondon or inNY
sessionTrend = ta.linreg(close, trendLenSession, 0)
sessionSlope = sessionTrend - sessionTrend[1]
plot(showTrendSession and sessionActive ? sessionTrend : na, "Session Trend", color=sessionSlope >= 0 ? color.aqua : color.orange, linewidth=3)

// 1M / 3M / 6M daily regression context
trend1M = request.security(syminfo.tickerid, "D", ta.linreg(close, trendLen1M, 0), lookahead=barmerge.lookahead_off)
trend3M = request.security(syminfo.tickerid, "D", ta.linreg(close, trendLen3M, 0), lookahead=barmerge.lookahead_off)
trend6M = request.security(syminfo.tickerid, "D", ta.linreg(close, trendLen6M, 0), lookahead=barmerge.lookahead_off)

trend1MSlope = trend1M - trend1M[1]
trend3MSlope = trend3M - trend3M[1]
trend6MSlope = trend6M - trend6M[1]

plot(showTrend1M ? trend1M : na, "1M Trend", color=color.new(color.cyan, 15), linewidth=2)
plot(showTrend3M ? trend3M : na, "3M Trend", color=color.new(color.blue, 25), linewidth=2)
plot(showTrend6M ? trend6M : na, "6M Trend", color=color.new(color.purple, 25), linewidth=2)

// ---------- Confluence engine ----------
bullTrendStack = sessionSlope > 0 and trend1MSlope > 0 and trend3MSlope > 0 and trend6MSlope > 0
bearTrendStack = sessionSlope < 0 and trend1MSlope < 0 and trend3MSlope < 0 and trend6MSlope < 0

bullConfluence = (inLondon or inNY) and structure == 1 and (inBullOTE or bullSweep) and (bullCHOCH or bullBOS or bullFVG) and bullTrendStack
bearConfluence = (inLondon or inNY) and structure == -1 and (inBearOTE or bearSweep) and (bearCHOCH or bearBOS or bearFVG) and bearTrendStack

plotshape(bullConfluence, "ICT/SMC BUY confluence", shape.labelup, location.belowbar, color=color.new(color.green, 0), textcolor=color.white, text="ICT BUY", size=size.small)
plotshape(bearConfluence, "ICT/SMC SELL confluence", shape.labeldown, location.abovebar, color=color.new(color.red, 0), textcolor=color.white, text="ICT SELL", size=size.small)

// ---------- Alerts ----------
alertcondition(bullCHOCH, "Bullish CHoCH", "Bullish CHoCH on {{ticker}} {{interval}}")
alertcondition(bearCHOCH, "Bearish CHoCH", "Bearish CHoCH on {{ticker}} {{interval}}")
alertcondition(bullSweep, "Bullish liquidity sweep", "Bullish liquidity sweep on {{ticker}} {{interval}}")
alertcondition(bearSweep, "Bearish liquidity sweep", "Bearish liquidity sweep on {{ticker}} {{interval}}")
alertcondition(bullConfluence, "ICT/SMC BUY", "ICT/SMC BUY confluence on {{ticker}} {{interval}}")
alertcondition(bearConfluence, "ICT/SMC SELL", "ICT/SMC SELL confluence on {{ticker}} {{interval}}")

// ---------- Dashboard ----------
var table dash = table.new(position.top_right, 2, 8, border_width=1)
if showDashboard and barstate.islast
    table.cell(dash, 0, 0, "ICT / SMC", bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(dash, 1, 0, syminfo.ticker, bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(dash, 0, 1, "Session")
    table.cell(dash, 1, 1, inLondon and inNY ? "London + NY" : inLondon ? "London" : inNY ? "New York" : "Off")
    table.cell(dash, 0, 2, "Structure")
    table.cell(dash, 1, 2, structure == 1 ? "Bullish" : structure == -1 ? "Bearish" : "Neutral")
    table.cell(dash, 0, 3, "OTE")
    table.cell(dash, 1, 3, inBullOTE ? "Bull OTE" : inBearOTE ? "Bear OTE" : "Outside")
    table.cell(dash, 0, 4, "Session Trend")
    table.cell(dash, 1, 4, sessionSlope > 0 ? "Up" : sessionSlope < 0 ? "Down" : "Flat")
    table.cell(dash, 0, 5, "1M / 3M / 6M")
    table.cell(dash, 1, 5, (trend1MSlope>0?"↑":"↓") + " " + (trend3MSlope>0?"↑":"↓") + " " + (trend6MSlope>0?"↑":"↓"))
    table.cell(dash, 0, 6, "Liquidity")
    table.cell(dash, 1, 6, bullSweep ? "Bull sweep" : bearSweep ? "Bear sweep" : "None")
    table.cell(dash, 0, 7, "Confluence")
    table.cell(dash, 1, 7, bullConfluence ? "BUY" : bearConfluence ? "SELL" : "WAIT",
        bgcolor=bullConfluence ? color.new(color.green, 25) : bearConfluence ? color.new(color.red, 25) : color.new(color.gray, 75),
        text_color=color.white)
