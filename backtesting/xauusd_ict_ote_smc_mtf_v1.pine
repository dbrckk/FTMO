//@version=6
strategy("XAUUSD ICT/SMC + Stoch + Bollinger Pro", overlay=true, pyramiding=0,
     process_orders_on_close=false, calc_on_order_fills=true,
     initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=0.25,
     commission_type=strategy.commission.cash_per_order, commission_value=0)

// =====================================================
// XAUUSD discretionary-style system
// Core: ICT / OTE / SMC / liquidity / session structure
// Confirmation: custom stochastic + adaptive Bollinger for Gold
// Sessions: London + New York
// Fixed risk model: TP 15 / SL 10 Gold points
// Non-repainting structure: confirmed pivots + lookahead_off HTF data
// =====================================================

// ---------- Sessions ----------
gSess = "Sessions"
londonSession = input.session("0800-1700", "London", group=gSess)
nySession = input.session("0800-1700", "New York", group=gSess)
londonTZ = input.string("Europe/London", "London timezone", group=gSess)
nyTZ = input.string("America/New_York", "New York timezone", group=gSess)
showSessionBG = input.bool(true, "Session background", group=gSess)
showKillZones = input.bool(true, "ICT kill zones", group=gSess)
londonKZ = input.session("0700-1000", "London kill zone", group=gSess)
nyKZ = input.session("0830-1100", "NY kill zone", group=gSess)

inLondon = not na(time(timeframe.period, londonSession, londonTZ))
inNY = not na(time(timeframe.period, nySession, nyTZ))
inSession = inLondon or inNY
inLondonKZ = not na(time(timeframe.period, londonKZ, londonTZ))
inNYKZ = not na(time(timeframe.period, nyKZ, nyTZ))

bgcolor(showSessionBG and inLondon ? color.new(color.blue, 93) : na)
bgcolor(showSessionBG and inNY ? color.new(color.orange, 93) : na)
bgcolor(showKillZones and inLondonKZ ? color.new(color.blue, 86) : na)
bgcolor(showKillZones and inNYKZ ? color.new(color.orange, 86) : na)

// ---------- Risk ----------
gRisk = "Trading"
tpPts = input.float(15.0, "Take Profit", minval=0.1, group=gRisk)
slPts = input.float(10.0, "Stop Loss", minval=0.1, group=gRisk)
minScore = input.float(6.5, "Minimum confluence score", minval=1, step=0.25, group=gRisk)
allowLong = input.bool(true, "Allow BUY", group=gRisk)
allowShort = input.bool(true, "Allow SELL", group=gRisk)

// ---------- SMC structure ----------
gSMC = "ICT / SMC"
pivotLen = input.int(3, "Confirmed swing length", minval=1, maxval=20, group=gSMC)
showBOS = input.bool(true, "BOS", group=gSMC)
showCHOCH = input.bool(true, "CHoCH", group=gSMC)
showOTE = input.bool(true, "OTE zone", group=gSMC)
showFVG = input.bool(true, "FVG", group=gSMC)
showOB = input.bool(true, "Order Blocks", group=gSMC)
showEQHL = input.bool(true, "EQH / EQL", group=gSMC)
showPremiumDiscount = input.bool(true, "Premium / Discount", group=gSMC)
eqTolATR = input.float(0.15, "EQH/EQL tolerance ATR", minval=0.01, step=0.01, group=gSMC)

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float lastSwingHigh = na
var float lastSwingLow = na
var float prevSwingHigh = na
var float prevSwingLow = na
var int structure = 0

if not na(ph)
    prevSwingHigh := lastSwingHigh
    lastSwingHigh := ph

if not na(pl)
    prevSwingLow := lastSwingLow
    lastSwingLow := pl

bullBreak = not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
bearBreak = not na(lastSwingLow) and close < lastSwingLow and close[1] >= lastSwingLow

bullCHOCH = bullBreak and structure == -1
bearCHOCH = bearBreak and structure == 1
bullBOS = bullBreak and structure != -1
bearBOS = bearBreak and structure != 1

if bullBreak
    structure := 1
if bearBreak
    structure := -1

if showBOS and bullBOS
    label.new(bar_index, low, "BOS ↑", style=label.style_label_up, color=color.new(color.green, 10), textcolor=color.white, size=size.tiny)
if showBOS and bearBOS
    label.new(bar_index, high, "BOS ↓", style=label.style_label_down, color=color.new(color.red, 10), textcolor=color.white, size=size.tiny)
if showCHOCH and bullCHOCH
    label.new(bar_index, low, "CHoCH ↑", style=label.style_label_up, color=color.new(color.teal, 0), textcolor=color.white, size=size.small)
if showCHOCH and bearCHOCH
    label.new(bar_index, high, "CHoCH ↓", style=label.style_label_down, color=color.new(color.maroon, 0), textcolor=color.white, size=size.small)

// ---------- OTE / premium discount ----------
swingRange = not na(lastSwingHigh) and not na(lastSwingLow) ? lastSwingHigh - lastSwingLow : na
eq = not na(swingRange) ? lastSwingLow + swingRange * 0.50 : na

bullOTE62 = structure == 1 ? lastSwingHigh - swingRange * 0.62 : na
bullOTE79 = structure == 1 ? lastSwingHigh - swingRange * 0.79 : na
bearOTE62 = structure == -1 ? lastSwingLow + swingRange * 0.62 : na
bearOTE79 = structure == -1 ? lastSwingLow + swingRange * 0.79 : na

pb62 = plot(showOTE and structure == 1 ? bullOTE62 : na, "Bull OTE 62", color=color.new(color.green, 20), style=plot.style_linebr)
pb79 = plot(showOTE and structure == 1 ? bullOTE79 : na, "Bull OTE 79", color=color.new(color.green, 20), style=plot.style_linebr)
fill(pb62, pb79, color=color.new(color.green, 88))

ps62 = plot(showOTE and structure == -1 ? bearOTE62 : na, "Bear OTE 62", color=color.new(color.red, 20), style=plot.style_linebr)
ps79 = plot(showOTE and structure == -1 ? bearOTE79 : na, "Bear OTE 79", color=color.new(color.red, 20), style=plot.style_linebr)
fill(ps62, ps79, color=color.new(color.red, 88))

plot(showPremiumDiscount ? eq : na, "Equilibrium", color=color.new(color.gray, 40), style=plot.style_linebr)
inDiscount = not na(eq) and close < eq
inPremium = not na(eq) and close > eq
inBullOTE = structure == 1 and not na(bullOTE62) and low <= bullOTE62 and high >= bullOTE79
inBearOTE = structure == -1 and not na(bearOTE62) and high >= bearOTE62 and low <= bearOTE79

// ---------- FVG ----------
bullFVG = low > high[2]
bearFVG = high < low[2]

if showFVG and bullFVG
    box.new(bar_index-2, low, bar_index+20, high[2], bgcolor=color.new(color.green, 90), border_color=color.new(color.green, 60))
if showFVG and bearFVG
    box.new(bar_index-2, low[2], bar_index+20, high, bgcolor=color.new(color.red, 90), border_color=color.new(color.red, 60))

// ---------- Order Blocks ----------
var float bullOBHigh = na
var float bullOBLow = na
var float bearOBHigh = na
var float bearOBLow = na
var bool bullOBBroken = false
var bool bearOBBroken = false

if bullBreak
    int foundBull = na
    for j = 1 to 12
        if close[j] < open[j] and na(foundBull)
            foundBull := j
    if not na(foundBull)
        bullOBHigh := high[foundBull]
        bullOBLow := low[foundBull]
        bullOBBroken := false
        if showOB
            box.new(bar_index-foundBull, bullOBHigh, bar_index+35, bullOBLow, bgcolor=color.new(color.green, 89), border_color=color.new(color.green, 55))

if bearBreak
    int foundBear = na
    for j = 1 to 12
        if close[j] > open[j] and na(foundBear)
            foundBear := j
    if not na(foundBear)
        bearOBHigh := high[foundBear]
        bearOBLow := low[foundBear]
        bearOBBroken := false
        if showOB
            box.new(bar_index-foundBear, bearOBHigh, bar_index+35, bearOBLow, bgcolor=color.new(color.red, 89), border_color=color.new(color.red, 55))

if not na(bullOBLow) and close < bullOBLow
    bullOBBroken := true
if not na(bearOBHigh) and close > bearOBHigh
    bearOBBroken := true

bullOBTouch = not na(bullOBHigh) and low <= bullOBHigh and high >= bullOBLow
bearOBTouch = not na(bearOBHigh) and high >= bearOBLow and low <= bearOBHigh
bullBreaker = bullOBBroken and bullOBTouch
bearBreaker = bearOBBroken and bearOBTouch

// ---------- EQH / EQL ----------
atr14 = ta.atr(14)
eqh = showEQHL and not na(ph) and not na(prevSwingHigh) and math.abs(ph - prevSwingHigh) <= atr14 * eqTolATR
eql = showEQHL and not na(pl) and not na(prevSwingLow) and math.abs(pl - prevSwingLow) <= atr14 * eqTolATR

if eqh
    label.new(bar_index-pivotLen, ph, "EQH", style=label.style_label_down, color=color.new(color.yellow, 5), textcolor=color.black, size=size.tiny)
if eql
    label.new(bar_index-pivotLen, pl, "EQL", style=label.style_label_up, color=color.new(color.aqua, 5), textcolor=color.black, size=size.tiny)

// ---------- Liquidity levels ----------
gLiq = "Liquidity"
showPrevSession = input.bool(true, "Previous session H/L", group=gLiq)
showPD = input.bool(true, "Previous Day H/L", group=gLiq)
showPW = input.bool(true, "Previous Week H/L", group=gLiq)
show30D = input.bool(true, "30-day H/L", group=gLiq)

var float londonHigh = na
var float londonLow = na
var float prevLondonHigh = na
var float prevLondonLow = na
newLondon = inLondon and not inLondon[1]
endLondon = not inLondon and inLondon[1]
if newLondon
    londonHigh := high
    londonLow := low
else if inLondon
    londonHigh := math.max(nz(londonHigh, high), high)
    londonLow := math.min(nz(londonLow, low), low)
if endLondon
    prevLondonHigh := londonHigh
    prevLondonLow := londonLow

var float nyHigh = na
var float nyLow = na
var float prevNYHigh = na
var float prevNYLow = na
newNY = inNY and not inNY[1]
endNY = not inNY and inNY[1]
if newNY
    nyHigh := high
    nyLow := low
else if inNY
    nyHigh := math.max(nz(nyHigh, high), high)
    nyLow := math.min(nz(nyLow, low), low)
if endNY
    prevNYHigh := nyHigh
    prevNYLow := nyLow

pdHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
pdLow = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_off)
pwHigh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_off)
pwLow = request.security(syminfo.tickerid, "W", low[1], lookahead=barmerge.lookahead_off)
d30High = request.security(syminfo.tickerid, "D", ta.highest(high[1], 30), lookahead=barmerge.lookahead_off)
d30Low = request.security(syminfo.tickerid, "D", ta.lowest(low[1], 30), lookahead=barmerge.lookahead_off)

plot(showPrevSession ? prevLondonHigh : na, "Prev London High", color=color.new(color.blue, 55), style=plot.style_stepline)
plot(showPrevSession ? prevLondonLow : na, "Prev London Low", color=color.new(color.blue, 55), style=plot.style_stepline)
plot(showPrevSession ? prevNYHigh : na, "Prev NY High", color=color.new(color.orange, 55), style=plot.style_stepline)
plot(showPrevSession ? prevNYLow : na, "Prev NY Low", color=color.new(color.orange, 55), style=plot.style_stepline)
plot(showPD ? pdHigh : na, "PDH", color=color.new(color.fuchsia, 30), style=plot.style_stepline)
plot(showPD ? pdLow : na, "PDL", color=color.new(color.fuchsia, 30), style=plot.style_stepline)
plot(showPW ? pwHigh : na, "PWH", color=color.new(color.purple, 35), style=plot.style_stepline)
plot(showPW ? pwLow : na, "PWL", color=color.new(color.purple, 35), style=plot.style_stepline)
plot(show30D ? d30High : na, "30D High", color=color.new(color.red, 25), linewidth=2, style=plot.style_stepline)
plot(show30D ? d30Low : na, "30D Low", color=color.new(color.green, 25), linewidth=2, style=plot.style_stepline)

sweepPDL = low < pdLow and close > pdLow
sweepPDH = high > pdHigh and close < pdHigh
sweep30L = low < d30Low and close > d30Low
sweep30H = high > d30High and close < d30High
sweepLondonL = not na(prevLondonLow) and low < prevLondonLow and close > prevLondonLow
sweepLondonH = not na(prevLondonHigh) and high > prevLondonHigh and close < prevLondonHigh
sweepNYL = not na(prevNYLow) and low < prevNYLow and close > prevNYLow
sweepNYH = not na(prevNYHigh) and high > prevNYHigh and close < prevNYHigh

bullSweep = sweepPDL or sweep30L or sweepLondonL or sweepNYL
bearSweep = sweepPDH or sweep30H or sweepLondonH or sweepNYH

plotshape(bullSweep, "Bull liquidity sweep", shape.triangleup, location.belowbar, color=color.aqua, size=size.tiny, text="LQ")
plotshape(bearSweep, "Bear liquidity sweep", shape.triangledown, location.abovebar, color=color.yellow, size=size.tiny, text="LQ")

// ---------- Trend stack ----------
gTrend = "Trend Context"
showTrendSession = input.bool(true, "Session trend", group=gTrend)
showTrend1M = input.bool(true, "1M trend", group=gTrend)
showTrend3M = input.bool(true, "3M trend", group=gTrend)
showTrend6M = input.bool(true, "6M trend", group=gTrend)

sessionTrend = ta.linreg(close, 24, 0)
sessionSlope = sessionTrend - sessionTrend[1]
trend1M = request.security(syminfo.tickerid, "D", ta.linreg(close, 21, 0), lookahead=barmerge.lookahead_off)
trend3M = request.security(syminfo.tickerid, "D", ta.linreg(close, 63, 0), lookahead=barmerge.lookahead_off)
trend6M = request.security(syminfo.tickerid, "D", ta.linreg(close, 126, 0), lookahead=barmerge.lookahead_off)
trend1Slope = trend1M - trend1M[1]
trend3Slope = trend3M - trend3M[1]
trend6Slope = trend6M - trend6M[1]

plot(showTrendSession and inSession ? sessionTrend : na, "Session Trend", color=sessionSlope>=0?color.aqua:color.orange, linewidth=3)
plot(showTrend1M ? trend1M : na, "1M Trend", color=color.new(color.cyan, 15), linewidth=2)
plot(showTrend3M ? trend3M : na, "3M Trend", color=color.new(color.blue, 25), linewidth=2)
plot(showTrend6M ? trend6M : na, "6M Trend", color=color.new(color.purple, 25), linewidth=2)

// ---------- Gold-tuned Bollinger ----------
gBB = "Gold Bollinger"
bbLen = input.int(20, "Base length", minval=5, group=gBB)
bbMult = input.float(2.20, "Base deviation", minval=0.5, step=0.05, group=gBB)
bbAtrLen = input.int(14, "ATR normalization", minval=5, group=gBB)
bbAtrBoost = input.float(0.35, "Volatility boost", minval=0, step=0.05, group=gBB)
showBB = input.bool(true, "Show Bollinger", group=gBB)

bbBasis = ta.ema(close, bbLen)
bbDev = ta.stdev(close, bbLen)
atrNorm = ta.atr(bbAtrLen)
volRatio = atrNorm / math.max(ta.sma(atrNorm, 50), syminfo.mintick)
adaptiveMult = bbMult + math.max(0.0, volRatio - 1.0) * bbAtrBoost
bbUpper = bbBasis + bbDev * adaptiveMult
bbLower = bbBasis - bbDev * adaptiveMult

pBBU = plot(showBB ? bbUpper : na, "Gold BB Upper", color=color.new(color.red, 20), linewidth=2)
pBBB = plot(showBB ? bbBasis : na, "Gold BB Basis", color=color.new(color.gray, 35), linewidth=1)
pBBL = plot(showBB ? bbLower : na, "Gold BB Lower", color=color.new(color.green, 20), linewidth=2)
fill(pBBU, pBBL, color=color.new(color.silver, 94))

bbBullReclaim = low < bbLower and close > bbLower
bbBearReclaim = high > bbUpper and close < bbUpper
bbBullTrend = close > bbBasis and bbBasis > bbBasis[1]
bbBearTrend = close < bbBasis and bbBasis < bbBasis[1]

// ---------- Gold stochastic ----------
gStoch = "Gold Stochastic"
stLen = input.int(14, "Stochastic length", minval=5, group=gStoch)
stSmoothK = input.int(3, "K smoothing", minval=1, group=gStoch)
stSmoothD = input.int(3, "D smoothing", minval=1, group=gStoch)
stOS = input.float(20, "Oversold", minval=1, maxval=50, group=gStoch)
stOB = input.float(80, "Overbought", minval=50, maxval=99, group=gStoch)

ll = ta.lowest(low, stLen)
hh = ta.highest(high, stLen)
rawK = 100 * (close - ll) / math.max(hh - ll, syminfo.mintick)
k = ta.ema(rawK, stSmoothK)
d = ta.ema(k, stSmoothD)

stBull = ta.crossover(k, d) and k < stOS + 10
stBear = ta.crossunder(k, d) and k > stOB - 10
stBullTrend = k > d and k > 50
stBearTrend = k < d and k < 50

// ---------- Confluence score ----------
bullScore = 0.0
bullScore += bullCHOCH ? 1.75 : 0
bullScore += bullBOS ? 1.00 : 0
bullScore += bullSweep ? 1.25 : 0
bullScore += bullFVG ? 0.75 : 0
bullScore += bullOBTouch ? 0.90 : 0
bullScore += bearBreaker ? 0.65 : 0
bullScore += inBullOTE ? 0.85 : 0
bullScore += inDiscount ? 0.55 : 0
bullScore += eql ? 0.50 : 0
bullScore += sessionSlope > 0 ? 0.55 : 0
bullScore += trend1Slope > 0 ? 0.35 : 0
bullScore += trend3Slope > 0 ? 0.35 : 0
bullScore += trend6Slope > 0 ? 0.35 : 0
bullScore += inLondonKZ or inNYKZ ? 0.45 : 0
bullScore += stBull ? 1.10 : stBullTrend ? 0.45 : 0
bullScore += bbBullReclaim ? 1.10 : bbBullTrend ? 0.45 : 0

bearScore = 0.0
bearScore += bearCHOCH ? 1.75 : 0
bearScore += bearBOS ? 1.00 : 0
bearScore += bearSweep ? 1.25 : 0
bearScore += bearFVG ? 0.75 : 0
bearScore += bearOBTouch ? 0.90 : 0
bearScore += bullBreaker ? 0.65 : 0
bearScore += inBearOTE ? 0.85 : 0
bearScore += inPremium ? 0.55 : 0
bearScore += eqh ? 0.50 : 0
bearScore += sessionSlope < 0 ? 0.55 : 0
bearScore += trend1Slope < 0 ? 0.35 : 0
bearScore += trend3Slope < 0 ? 0.35 : 0
bearScore += trend6Slope < 0 ? 0.35 : 0
bearScore += inLondonKZ or inNYKZ ? 0.45 : 0
bearScore += stBear ? 1.10 : stBearTrend ? 0.45 : 0
bearScore += bbBearReclaim ? 1.10 : bbBearTrend ? 0.45 : 0

longSignal = allowLong and inSession and bullScore >= minScore and bullScore > bearScore
shortSignal = allowShort and inSession and bearScore >= minScore and bearScore > bullScore

// ---------- Strategy ----------
if strategy.position_size == 0
    if longSignal
        strategy.entry("BUY", strategy.long)
    else if shortSignal
        strategy.entry("SELL", strategy.short)

if strategy.position_size > 0
    strategy.exit("BUY EXIT", "BUY", stop=strategy.position_avg_price-slPts, limit=strategy.position_avg_price+tpPts)

if strategy.position_size < 0
    strategy.exit("SELL EXIT", "SELL", stop=strategy.position_avg_price+slPts, limit=strategy.position_avg_price-tpPts)

// ---------- Visual signals ----------
plotshape(longSignal, "BUY setup", shape.labelup, location.belowbar, color=color.new(color.green, 0), textcolor=color.white, text="BUY", size=size.small)
plotshape(shortSignal, "SELL setup", shape.labeldown, location.abovebar, color=color.new(color.red, 0), textcolor=color.white, text="SELL", size=size.small)

// ---------- Dashboard ----------
var table dash = table.new(position.top_right, 2, 10, border_width=1)
if barstate.islast
    table.cell(dash,0,0,"XAUUSD PRO",bgcolor=color.black,text_color=color.white)
    table.cell(dash,1,0,"ICT/SMC",bgcolor=color.black,text_color=color.white)
    table.cell(dash,0,1,"Session")
    table.cell(dash,1,1,inLondon and inNY?"London + NY":inLondon?"London":inNY?"New York":"Off")
    table.cell(dash,0,2,"Structure")
    table.cell(dash,1,2,structure==1?"Bullish":structure==-1?"Bearish":"Neutral")
    table.cell(dash,0,3,"Bull Score")
    table.cell(dash,1,3,str.tostring(bullScore,"#.##"))
    table.cell(dash,0,4,"Bear Score")
    table.cell(dash,1,4,str.tostring(bearScore,"#.##"))
    table.cell(dash,0,5,"Stoch")
    table.cell(dash,1,5,str.tostring(k,"#.0") + " / " + str.tostring(d,"#.0"))
    table.cell(dash,0,6,"Bollinger")
    table.cell(dash,1,6,bbBullReclaim?"Bull reclaim":bbBearReclaim?"Bear reclaim":"Neutral")
    table.cell(dash,0,7,"OTE")
    table.cell(dash,1,7,inBullOTE?"Bull OTE":inBearOTE?"Bear OTE":"Outside")
    table.cell(dash,0,8,"Liquidity")
    table.cell(dash,1,8,bullSweep?"Bull sweep":bearSweep?"Bear sweep":"None")
    table.cell(dash,0,9,"Decision")
    table.cell(dash,1,9,longSignal?"BUY":shortSignal?"SELL":"WAIT",
      bgcolor=longSignal?color.new(color.green,20):shortSignal?color.new(color.red,20):color.new(color.gray,75),
      text_color=color.white)

// ---------- Alerts ----------
alertcondition(longSignal, "XAUUSD BUY", "XAUUSD ICT/SMC BUY setup")
alertcondition(shortSignal, "XAUUSD SELL", "XAUUSD ICT/SMC SELL setup")
alertcondition(bullCHOCH, "Bullish CHoCH", "Bullish CHoCH detected")
alertcondition(bearCHOCH, "Bearish CHoCH", "Bearish CHoCH detected")
alertcondition(bullSweep, "Bullish liquidity sweep", "Bullish liquidity sweep detected")
alertcondition(bearSweep, "Bearish liquidity sweep", "Bearish liquidity sweep detected")
